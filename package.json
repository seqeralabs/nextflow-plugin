{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-nextflow",
  "version": "0.2.2",
  "type": "module",
  "description": "Build, migrate, test, debug, and run Nextflow pipelines with Nextflow Platform, Wave, and nf-core — OpenCode 1.x and 2.x plugin.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seqeralabs/nextflow-plugin.git"
  },
  "homepage": "https://github.com/seqeralabs/nextflow-plugin",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "nextflow",
    "seqera",
    "nf-core",
    "bioinformatics",
    "pipelines"
  ],
  "main": "./opencode/index.ts",
  "exports": {
    ".": "./opencode/index.ts",
    "./server": "./opencode/index.ts"
  },
  "oc-plugin": [
    "server"
  ],
  "files": [
    "opencode/index.ts",
    "opencode/config.ts",
    "skills/",
    "scripts/",
    "licenses/",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "verify:pack": "npm pack --dry-run"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.0",
    "@opencode/plugin": "^2.0.28",
    "@types/bun": "1.3.13",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.4 <2",
    "@opencode/plugin": ">=2.0.0 <3"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "opencode": ">=1.17.4 <3"
  }
}
