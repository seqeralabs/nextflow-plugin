{
  "nextflow": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/nextflow-language-server.sh",
    "extensionToLanguage": {
      ".nf": "nextflow",
      ".nf.test": "nextflow",
      ".config": "nextflow-config"
    },
    "startupTimeout": 120000,
    "settings": {
      "nextflow": {
        "files": {
          "exclude": [".git", ".lineage", ".nf-test", ".pixi", ".venv", "work"]
        }
      }
    }
  }
}
